# Database
DB_NAME = CharSheet
DB_USER = postgres
DB_PASSWORD = change_me
REDIS_URL = redis://redis:6379/0
DB_URL = postgresql+asyncpg://postgres:change_me@db:5432/CharSheet

# Messaging (RabbitMQ)
RABBITMQ_URL = amqp://backend:backend@rabbitmq:5672/
RABBITMQ_DEFAULT_USER = backend
RABBITMQ_DEFAULT_PASS = backend
RABBITMQ_EXCHANGE = dnd.events
RABBITMQ_QUEUE_PREFIX = backend
RABBITMQ_EXCHANGE_TYPE = topic
RABBITMQ_PREFETCH_COUNT = 10
RABBITMQ_RECONNECT_INTERVAL_SECONDS = 5.0

# Security / AI
JWT_SECRET_KEY = change_me
GEMINI_API_KEY = 
DEFAULT_AI_MODEL = gemini-2.5-flash